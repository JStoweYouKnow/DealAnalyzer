{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    "CLERK_*",
    "CONVEX_*",
    "OPENAI_API_KEY",
    "DATABASE_URL",
    "REDIS_URL",
    "VERCEL_*",
    "SENTRY_*",
    "API_NINJAS_API_KEY",
    "RENTCAST_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "out/**",
        "android/app/build/**",
        "ios/build/**"
      ],
      "env": [
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "app/**/*.tsx",
        "app/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "__tests__/**/*.ts",
        "__tests__/**/*.tsx"
      ]
    },
    "clean": {
      "cache": false
    },
    "convex:dev": {
      "cache": false,
      "persistent": true
    },
    "convex:deploy": {
      "cache": false,
      "outputs": []
    },
    "convex:codegen": {
      "cache": false,
      "outputs": ["convex/_generated/**"]
    }
  }
}
