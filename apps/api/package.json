{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/index.ts",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dealanalyzer/types": "workspace:*",
    "@dealanalyzer/analysis-engine": "workspace:*",
    "@dealanalyzer/external-apis": "workspace:*",
    "@dealanalyzer/storage": "workspace:*",
    "@dealanalyzer/ai-services": "workspace:*",
    "@dealanalyzer/utils": "workspace:*",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "dotenv": "^17.2.3",
    "axios": "^1.13.2",
    "convex": "^1.28.0",
    "connect-redis": "^9.0.0",
    "ioredis": "^5.8.2",
    "googleapis": "^159.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "openai": "^5.20.2",
    "puppeteer-core": "^24.26.1",
    "@sparticuz/chromium-min": "^141.0.0",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.0",
    "pdfjs-dist": "^5.4.296",
    "exceljs": "^4.4.0",
    "csv-parse": "^6.1.0",
    "csv-writer": "^1.6.0",
    "@vercel/blob": "^1.1.1",
    "resend": "^6.4.2",
    "stripe": "^20.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@dealanalyzer/config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.25",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
