{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "lib": ["es2017", "dom"],
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@dealanalyzer/types": ["../types/dist/index.d.ts"],
      "@dealanalyzer/types/*": ["../types/dist/*.d.ts"],
      "@dealanalyzer/utils": ["../utils/dist/index.d.ts"],
      "@dealanalyzer/utils/*": ["../utils/dist/*.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../types", "../utils", "../**/dist"],
  "references": [
    { "path": "../types" },
    { "path": "../utils" }
  ]
}
