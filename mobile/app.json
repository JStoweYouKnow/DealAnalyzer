{
  "expo": {
    "name": "The Comfort Finder",
    "slug": "deal-analyzer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.comfortfinder.dealanalyzer",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select property images for analysis.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of property documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.comfortfinder.dealanalyzer",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DealAnalyzer to access your photos to analyze property documents."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "clerkPublishableKey": "pk_test_c3BlY2lhbC1ib2FyLTE3LmNsZXJrLmFjY291bnRzLmRldiQ",
      "convexUrl": "https://mild-bullfrog-475.convex.cloud",
      "apiUrl": "https://comfort-finder-analyzer.vercel.app"
    }
  }
}
