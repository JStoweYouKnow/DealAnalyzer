# Exclude unnecessary files from EAS builds

# Dependencies and build artifacts
node_modules/
.git/
.expo/
dist/
web-build/
build/
coverage/
*.log
*.tsbuildinfo

# Documentation files (not needed for builds)
*.md
README.md
CHANGELOG.md
LICENSE
*.txt

# Configuration examples and templates
*.example
*.template
*.sample

# Shell scripts (not needed in build)
*.sh
prepare-build.sh
update-icon.sh
link-shared.sh

# Environment files (use EAS secrets instead)
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# App Store Connect API Key (sensitive - use EAS secrets)
asc-api-key.p8
*.p8

# Temporary and cache files
*.tmp
*.temp
*.bak
*.cache
.metro-health-check*

# Test files
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
*.test.js
*.spec.js

# Exclude parent directory files
../node_modules/
../.git/
../*.md
../dist/
../temp_uploads/
../python_modules/
../attached_assets/
../assets/nutrient-viewer-lib/

