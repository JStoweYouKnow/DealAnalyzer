# EAS Build Ignore
# Files to exclude from EAS build uploads to reduce size and speed up builds

# iOS
ios/build/
ios/Pods/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/

# Android
android/build/
android/.gradle/
android/app/build/
android/gradle/
android/.idea/

# Node
node_modules/

# Expo
.expo/
.expo-shared/

# Misc
*.log
*.tmp
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Documentation
*.md
docs/
